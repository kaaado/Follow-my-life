# Supabase Cloud Configuration
# Copy this file to .env and configure your keys.
# DO NOT commit .env with real secrets to version control!

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DIRECT_HOST=db.your-project-ref.supabase.co
SUPABASE_DIRECT_PORT=5432
SUPABASE_DIRECT_DATABASE=postgres
SUPABASE_DIRECT_USER=postgres
